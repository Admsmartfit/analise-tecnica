# Trading System B3 — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# Data and databases (large binary files, sensitive)
data/ohlcv/
data/db/
data/backups/
*.parquet
*.db
*.db-wal
*.db-shm

# Logs
logs/
*.jsonl
*.log

# Config secrets (passwords never go to git)
config/secrets.yaml

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Type checking
.mypy_cache/
.dmypy.json

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Ruff
.ruff_cache/

# Temporary files
*.tmp
*.bak
