# Trading System B3 â€” .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# Data and databases (large binary files, sensitive)
data/ohlcv/
data/db/
data/backups/
*.parquet
*.db
*.db-wal
*.db-shm

# Logs
logs/
*.jsonl
*.log

# Config secrets (passwords never go to git)
config/secrets.yaml
# Machine-specific overrides (login MT5, provider, Telegram chat) - the auto-updater never touches them
config/settings.local.yaml

# Installer build output (o CI gera o Setup.exe a cada push)
dist/
deploy/installer/obj/

# Runtime artifacts
data/reference/
data/ts.lock
reports/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Type checking
.mypy_cache/
.dmypy.json

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Ruff
.ruff_cache/

# Temporary files
*.tmp
*.bak

# Configuracao aprovada localmente (reotimizacao da quarentena) - nunca versionar
config/strategy.override.yaml
config/strategy.candidate*.yaml
config/history/
